<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>

		<PackageId>Gufel.Dispatcher</PackageId>
		<Title>Gufel Dispatcher (CQRS And Mediator)</Title>
		<Authors>mahdiit</Authors>
		<Version>1.2.3</Version>
		<Description>CQRS And Mediator with pipeline handler and message publisher</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/mahdiit/Gufel.CQRS</RepositoryUrl>
		<PackageTags>cqrs;mediator;message;notification;task;dispatcher</PackageTags>
		<PackageIcon>dispatcher.jpg</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/mahdiit/Gufel.CQRS</PackageProjectUrl>
		<PackageReleaseNotes>## 1.2.3
- FireAndForgetPublishStrategy: replaced Task.Run with System.Threading.Channels for bounded/unbounded producer-consumer message dispatch
- FireAndForgetPublishStrategy: simplified, removed inner strategy dependency; subscribers are invoked directly via Parallel.ForEachAsync in the channel consumer
- FireAndForgetPublishStrategy: added ILogger support for error logging on subscriber exceptions
- AddFireAndForgetMessagePublisher registration: simplified signature, added optional channelCapacity parameter</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\dispatcher.jpg">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>
</Project>
